<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlInventarioMovil.Views.ShareInventoryPage"
             xmlns:helpers="clr-namespace:ControlInventarioMovil.Helpers"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#161F27}">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,10" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A232C}">
            <ImageButton Grid.Column="0" Source="back_icon.png" WidthRequest="32" HeightRequest="32" BackgroundColor="Transparent" Padding="4" VerticalOptions="Center" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnVolverClicked"/>
            <Label Grid.Column="1" Text="COMPARTIR INVENTARIO" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
            <BoxView Grid.Column="2" WidthRequest="32" Color="Transparent"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="15">

                <Label Text="CONCEDER ACCESO COLABORATIVO" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" Margin="0,0,0,-10"/>

                <Border StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="15">
                    <VerticalStackLayout Spacing="15">

                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Switch x:Name="SwModoAvanzado" Toggled="OnModoAvanzadoToggled" OnColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}"/>
                            <Label Text="Modo Avanzado (Gestionar otros inventarios)" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#54606C, Dark=#A0E2FF}" FontAttributes="Bold" FontSize="13"/>
                        </HorizontalStackLayout>

                        <Grid x:Name="ContenedorInventarios" IsVisible="False" ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,5,0,0">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#161F27}" HeightRequest="46">
                                <Picker x:Name="PkrInventarios" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" SelectedIndexChanged="OnInventarioSeleccionadoChanged" Margin="10,0"/>
                            </Border>

                            <ImageButton Grid.Column="1" Source="add_icon.png" BackgroundColor="Transparent" Padding="8" WidthRequest="46" HeightRequest="46" VerticalOptions="Center" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnCrearNuevoInventarioPopUpClicked"/>
                        </Grid>

                        <Label Text="Seleccionar Miembro del Entorno *" FontSize="13" TextColor="{AppThemeBinding Light=#54606C, Dark=#A0E2FF}" FontAttributes="Bold" Margin="0,0,0,-10"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#161F27}" HeightRequest="46">
                            <Picker x:Name="pckEmployee" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" ItemDisplayBinding="{Binding FirstName}" Margin="10,0"/>
                        </Border>

                        <Label Text="Nivel de Permiso (Rol de Contexto) *" FontSize="13" TextColor="{AppThemeBinding Light=#54606C, Dark=#A0E2FF}" FontAttributes="Bold" Margin="0,0,0,-10"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#161F27}" HeightRequest="46">
                            <Picker x:Name="pckAccessLevel" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" ItemDisplayBinding="{Binding Name}" Margin="10,0"/>
                        </Border>

                        <Button x:Name="btnShare" Text="OTORGAR ACCESO" BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" TextColor="{AppThemeBinding Light=White, Dark=#1C262E}" FontAttributes="Bold" CornerRadius="8" HeightRequest="46" Margin="0,10,0,0" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnShareClicked"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="COLABORADORES ACTIVOS EN ESTE INVENTARIO" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" Margin="0,10,0,-10"/>

                <Border StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="15">
                    <CollectionView x:Name="cvSharedUsers" EmptyView="No hay colaboradores vinculados a este inventario.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 8" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#161F27}" Padding="15" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15" VerticalOptions="Center">

                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="{Binding User.Username}" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}"/>
                                            <Label Text="{Binding AccessLevel}" FontSize="13" TextColor="{AppThemeBinding Light=#54606C, Dark=#A0E2FF}"/>
                                        </VerticalStackLayout>

                                        <ImageButton Grid.Column="1" Source="edit_icon.png" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnEditAccessClicked" CommandParameter="{Binding .}" VerticalOptions="Center"/>
                                        <ImageButton Grid.Column="2" Source="delete_icon.png" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnRevokeAccessClicked" CommandParameter="{Binding .}" VerticalOptions="Center"/>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>