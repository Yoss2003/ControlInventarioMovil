<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ControlInventario.Shared.Models;assembly=ControlInventario.Shared"
             xmlns:DTO="clr-namespace:ControlInventario.Shared.Models.DTO;assembly=ControlInventario.Shared"
             xmlns:utilities="clr-namespace:ControlInventarioMovil.Utilities"
             x:Class="ControlInventarioMovil.Views.RegistrosPage"
             Shell.NavBarIsVisible="False"
             Title="Registros y Auditoría"
             BackgroundColor="{AppThemeBinding Light=#F4F6FA, Dark=#0F151A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <utilities:ActionTypeConverter x:Key="ActionTypeConverter" />
            <utilities:ActionTypeColorConverter x:Key="ActionColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Agregamos una fila extra para la Barra de Herramientas -->
    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">

        <!-- 1. ENCABEZADO SUPERIOR -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="16,15,16,10">
            <ImageButton Source="arrow_back.png" 
                         BackgroundColor="Transparent"
                         HeightRequest="24" WidthRequest="24" 
                         VerticalOptions="Center" 
                         Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="Registros y Auditoría" 
                   FontSize="20" FontAttributes="Bold" 
                   VerticalOptions="Center" Margin="15,0,0,0" 
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
        </Grid>

        <!-- 2. BUSCADOR -->
        <SearchBar Grid.Row="1" x:Name="searchBar" 
                   Placeholder="Buscar producto o usuario..." 
                   TextChanged="OnSearchTextChanged" 
                   Margin="16,0,16,10" />

        <!-- 3. PESTAÑAS -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="16,0,16,0" ColumnSpacing="8">
            <Button x:Name="BtnTabKardex" Grid.Column="0" Text="📦 Kárdex" FontAttributes="Bold" CornerRadius="8" BackgroundColor="#8A2BE2" TextColor="White" Clicked="OnTabKardexClicked"/>
            <Button x:Name="BtnTabLogs" Grid.Column="1" Text="🕵️ Auditoría" FontAttributes="Bold" CornerRadius="8" BackgroundColor="Transparent" TextColor="Gray" BorderColor="Gray" BorderWidth="1" Clicked="OnTabLogsClicked"/>
        </Grid>

        <!-- 4. BARRA DE HERRAMIENTAS (Exportar / Expandir) -->
        <!-- Usamos x:Name para poder ocultarla desde C# cuando pases a la pestaña de Auditoría -->
        <Grid Grid.Row="3" x:Name="ToolbarKardex" ColumnDefinitions="*, *, *, *" Margin="16,10,16,12" ColumnSpacing="8">
            <!-- Botón Expandir Todo -->
            <Button Grid.Column="0" Text="Expandir" ImageSource="expand_all_icon.png" ContentLayout="Left,4" FontSize="10" BackgroundColor="{AppThemeBinding Light=#EBE6F7, Dark=#201633}" TextColor="{AppThemeBinding Light=Black, Dark=White}" CornerRadius="8" HeightRequest="40" Clicked="OnExpandAllClicked" Padding="0"/>

            <!-- Botón Contraer Todo -->
            <Button Grid.Column="1" Text="Contraer" ImageSource="collapse_all_icon.png" ContentLayout="Left,4" FontSize="10" BackgroundColor="{AppThemeBinding Light=#EBE6F7, Dark=#201633}" TextColor="{AppThemeBinding Light=Black, Dark=White}" CornerRadius="8" HeightRequest="40" Clicked="OnCollapseAllClicked" Padding="0"/>

            <Button Grid.Column="2" Text="📄 Exp. Sel." FontSize="10" BackgroundColor="#1B4F5F" TextColor="White" CornerRadius="8" HeightRequest="40" Clicked="OnExportSelectedClicked" Padding="0"/>
            <Button Grid.Column="3" Text="📑 Exp. Todo" FontSize="10" BackgroundColor="#8A2BE2" TextColor="White" CornerRadius="8" HeightRequest="40" Clicked="OnExportAllClicked" Padding="0"/>
        </Grid>

        <!-- 5. LISTA DE KÁRDEX AGRUPADO POR PRODUCTO (ACORDEÓN) -->
        <RefreshView Grid.Row="4" x:Name="refreshKardex" Refreshing="OnRefreshKardexRequested">
            <CollectionView x:Name="listKardex" SelectionMode="None" Margin="16,0">

                <!-- Separación uniforme de 16px entre cada producto -->
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="DTO:ProductKardexGroup">
                        <VerticalStackLayout Spacing="0">

                            <!-- CABECERA DEL PRODUCTO (PADRE) -->
                            <Border Padding="14,10" BackgroundColor="{AppThemeBinding Light=#EBE6F7, Dark=#201633}" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGroupHeaderTapped" />
                                </Border.GestureRecognizers>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <!-- Modificamos las columnas para agregar el CheckBox -->
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Color="#00CED1" VerticalOptions="Center" Margin="0,0,10,0"/>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding ArticleName}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#8A2BE2, Dark=#B67BFF}"/>
                                        <Label Text="{Binding Sku, StringFormat='SKU: {0}'}" FontSize="11" TextColor="Gray"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,15,0">
                                        <Label Text="Stock Actual" FontSize="10" TextColor="Gray" HorizontalOptions="End"/>
                                        <Label Text="{Binding CurrentStock, StringFormat='{0:N2} un.'}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1B4F5F, Dark=#00CED1}" HorizontalOptions="End"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="3" Text="{Binding ExpansionIcon}" FontSize="16" VerticalOptions="Center" TextColor="Gray"/>
                                </Grid>
                            </Border>

                            <!-- LISTA DE MOVIMIENTOS (HIJOS) -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding AllMovements}" 
                                                 IsVisible="{Binding IsExpanded}"
                                                 Margin="25,8,25,0" 
                                                 Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="DTO:KardexMovementDto">
                                        <Border Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#171F24}" StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="8">

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Border Grid.Column="0" BackgroundColor="{Binding ActionId, Converter={StaticResource ActionColorConverter}}" StrokeThickness="0" Padding="8,3">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding ActionId, Converter={StaticResource ActionTypeConverter}}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                                    </Border>
                                                    <Label Grid.Column="2" Text="{Binding MovementDate}" TextColor="Gray" FontSize="11" VerticalOptions="Center"/>
                                                </Grid>

                                                <Label Text="{Binding Observation}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                                        <Label Text="Movimiento:" TextColor="Gray" FontSize="12"/>
                                                        <Label Text="{Binding AmountDisplay}" FontAttributes="Bold" FontSize="13" TextColor="{Binding ActionId, Converter={StaticResource ActionColorConverter}}"/>
                                                    </HorizontalStackLayout>
                                                    <Label Grid.Column="2" Text="{Binding TotalValue, StringFormat='Total: S/ {0:N2}'}" TextColor="Gray" FontSize="12" VerticalOptions="Center"/>
                                                </Grid>

                                                <Label Text="{Binding Recipient, StringFormat='Cliente: {0}'}" TextColor="#8A2BE2" FontSize="11" FontAttributes="Italic" IsVisible="{Binding HasRecipient}"/>

                                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A353D}"/>

                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Label Grid.Column="0" Text="📦 Saldo acumulado:" TextColor="Gray" FontSize="11" FontAttributes="Italic"/>
                                                    <Label Grid.Column="1" Text="{Binding RunningBalance, StringFormat='{0} un.'}" TextColor="Gray" FontSize="11" FontAttributes="Bold"/>
                                                </Grid>

                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- 6. LISTA DE AUDITORÍA -->
        <RefreshView Grid.Row="4" x:Name="refreshLogs" Refreshing="OnRefreshLogsRequested" IsVisible="False">
            <CollectionView x:Name="listLogs" SelectionMode="None" Margin="16,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryLog">
                        <Grid Padding="0,0,0,12">
                            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#171F24}" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="0,0,0,6">
                                        <Label Grid.Column="0" Text="🟢" FontSize="12" VerticalOptions="Center" Margin="0,0,8,0"/>
                                        <Label Grid.Column="1" Text="{Binding Username}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Column="2" Text="{Binding LogDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}" TextColor="Gray" FontSize="12" VerticalOptions="Center" HorizontalOptions="End"/>
                                    </Grid>
                                    <Label Text="{Binding Detail}" TextColor="Gray" FontSize="14" LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding ModuleName, StringFormat='Módulo: {0}'}" TextColor="#00CED1" FontSize="11" FontAttributes="Bold" Margin="0,4,0,0"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>