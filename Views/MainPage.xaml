<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlInventarioMovil.Views.Controls"
             xmlns:helpers="clr-namespace:ControlInventarioMovil.Helpers"
             xmlns:viewmodels="clr-namespace:ControlInventarioMovil.ViewModels"
             x:Class="ControlInventarioMovil.Views.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}"
             Shell.NavBarIsVisible="False">

    <ContentView x:Name="InteractionDetector" BackgroundColor="Transparent">
        <ContentView.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnPageInteraction" />
        </ContentView.GestureRecognizers>

        <Grid RowDefinitions="Auto, Auto, *, Auto">

            <Grid Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#1B4F5F, Dark=#161F27}" Padding="15,10" ColumnDefinitions="*, Auto, *">
                <Image Grid.Column="0" Source="warehouse_ico" HeightRequest="25" WidthRequest="25" HorizontalOptions="Start" VerticalOptions="Center"/>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 8" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" HeightRequest="46" WidthRequest="220" VerticalOptions="Center">
                        <Picker ItemsSource="{Binding AvailableWorkspacesNames}" SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=TwoWay}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" FontSize="14" HorizontalOptions="Fill" VerticalOptions="Fill" Margin="15,0"/>
                    </Border>

                    <ImageButton Source="add_icon.png" BackgroundColor="Transparent" Padding="8" WidthRequest="38" HeightRequest="38" VerticalOptions="Center" helpers:EfectosVisualesHelper.Animar="True" Command="{Binding CreateWarehouseCommand}"/>
                    <ImageButton Source="search_icon.png" BackgroundColor="Transparent" Padding="8" WidthRequest="38" HeightRequest="38" VerticalOptions="Center" helpers:EfectosVisualesHelper.Animar="True" Command="{Binding ShareInventoryCommand}" IsVisible="{Binding IsShareVisible}"/>
                </HorizontalStackLayout>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*, Auto, *" Padding="20,20,20,0">

                <VerticalStackLayout Grid.Column="0" Spacing="5" HorizontalOptions="Center" VerticalOptions="Start">
                    <ImageButton Source="user_icon.png" HeightRequest="52" WidthRequest="52" CornerRadius="26" BackgroundColor="{AppThemeBinding Light=White, Dark=#222B34}" BorderWidth="1" BorderColor="{AppThemeBinding Light=#D3D3D3, Dark=#2E3842}" Padding="12" Command="{Binding NavigateToCustomersCommand}" helpers:EfectosVisualesHelper.Animar="True"/>
                    <Label Text="Clientes" FontSize="11" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Margin="15,0">
                    <Label Text="{Binding GreetingText}" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding RoleText}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" HorizontalTextAlignment="Center" FontSize="14"/>
                    <Border BackgroundColor="{Binding BadgeAlertsBgColor}" HorizontalOptions="Center" Padding="12,3" Margin="0,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding BadgeAlertsText}" TextColor="{Binding BadgeAlertsTextColor}" FontAttributes="Bold" FontSize="11"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="5" HorizontalOptions="Center" VerticalOptions="Start">
                    <ImageButton Source="user_icon.png" HeightRequest="52" WidthRequest="52" CornerRadius="26" BackgroundColor="{AppThemeBinding Light=White, Dark=#222B34}" BorderWidth="1" BorderColor="{AppThemeBinding Light=#D3D3D3, Dark=#2E3842}" Padding="12" Opacity="{Binding EmployeesButtonOpacity}" Command="{Binding NavigateToEmployeesCommand}" helpers:EfectosVisualesHelper.Animar="True"/>
                    <Label Text="Empleados" FontSize="11" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ORBITAL -->
            <Grid Grid.Row="2" x:Name="ContenedorOrbital" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="280" WidthRequest="280">

                <Border x:Name="AroEnergia" WidthRequest="200" HeightRequest="200" HorizontalOptions="Center" VerticalOptions="Center" TranslationY="-5" BackgroundColor="Transparent" StrokeThickness="3" Stroke="{AppThemeBinding Light=#1B4F5F, Dark=#A2D149}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100"/>
                    </Border.StrokeShape>
                </Border>

                <Grid x:Name="OrbitaRegistros" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="False">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Border HeightRequest="48" WidthRequest="48" Padding="8" BackgroundColor="{AppThemeBinding Light=White, Dark=#222B34}" StrokeThickness="1" Stroke="{AppThemeBinding Light=#D3D3D3, Dark=#2E3842}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24"/>
                            </Border.StrokeShape>
                            <Image Source="registros.png"/>
                        </Border>
                        <Label x:Name="TxtRegistros" Text="Registros" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontSize="12"/>
                    </VerticalStackLayout>
                </Grid>

                <Grid x:Name="OrbitaInventario" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="False">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Border HeightRequest="48" WidthRequest="48" Padding="8" BackgroundColor="{AppThemeBinding Light=White, Dark=#222B34}" StrokeThickness="1" Stroke="{AppThemeBinding Light=#D3D3D3, Dark=#2E3842}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24"/>
                            </Border.StrokeShape>
                            <Image Source="inventario.png"/>
                        </Border>
                        <Label x:Name="TxtInventario" Text="Inventario" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontSize="12"/>
                    </VerticalStackLayout>
                </Grid>

                <Grid x:Name="OrbitaReportes" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="False" IsVisible="{Binding IsReportsVisible}">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Border HeightRequest="48" WidthRequest="48" Padding="8" BackgroundColor="{AppThemeBinding Light=White, Dark=#222B34}" StrokeThickness="1" Stroke="{AppThemeBinding Light=#D3D3D3, Dark=#2E3842}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24"/>
                            </Border.StrokeShape>
                            <Image Source="reportes.png"/>
                        </Border>
                        <Label x:Name="TxtReportes" Text="Reportes" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontSize="12"/>
                    </VerticalStackLayout>
                </Grid>

                <Grid x:Name="OrbitaConfig" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="False" IsVisible="{Binding IsConfigVisible}">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Border HeightRequest="48" WidthRequest="48" Padding="8" BackgroundColor="{AppThemeBinding Light=White, Dark=#222B34}" StrokeThickness="1" Stroke="{AppThemeBinding Light=#D3D3D3, Dark=#2E3842}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24"/>
                            </Border.StrokeShape>
                            <Image Source="config_icon.png"/>
                        </Border>
                        <Label x:Name="TxtConfig" Text="Configuración" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontSize="12"/>
                    </VerticalStackLayout>
                </Grid>

                <Border HeightRequest="120" WidthRequest="120" BackgroundColor="#A8D08D" StrokeThickness="0" TranslationY="-5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="60"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#A8D08D, Dark=#000000}" Offset="0,0" Radius="15" Opacity="0.5"/>
                    </Border.Shadow>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Stock OK" FontSize="22" FontAttributes="Bold" TextColor="#1B4F5F" HorizontalOptions="Center"/>
                        <Label Text="{Binding TotalArticlesText}" FontSize="14" TextColor="#1B4F5F" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <controls:FooterView x:Name="FooterView" Grid.Row="3" />

            <Grid BackgroundColor="#CC000000" IsVisible="{Binding IsQuickStockVisible}" ZIndex="150" Grid.RowSpan="4">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseQuickStockCommand}"/>
                </Grid.GestureRecognizers>
                <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid RowDefinitions="Auto, *, Auto">
                        <VerticalStackLayout Grid.Row="0" Padding="15" BackgroundColor="#8A2BE2">
                            <Label Text="INGRESO RÁPIDO DE STOCK" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
                            <Label Text="{Binding QuickStockName}" TextColor="#E0E0E0" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" Margin="0,5,0,0" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="15">
                            <Label Text="{Binding QuickStockCurrentText}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="13" HorizontalOptions="Center" FontAttributes="Bold"/>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Cantidad Nueva a Ingresar *" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="12"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="45">
                                    <Entry Text="{Binding QuickStockAddAmount, Mode=TwoWay}" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent" Placeholder="Ej. 10" HorizontalTextAlignment="Center" FontAttributes="Bold" FontSize="16"/>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15" Padding="15" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#161F27}">
                            <Button Grid.Column="0" Text="CANCELAR" BackgroundColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" CornerRadius="8" Command="{Binding CloseQuickStockCommand}"/>
                            <Button Grid.Column="1" Text="AGREGAR" BackgroundColor="#A2D149" TextColor="#1C262E" FontAttributes="Bold" CornerRadius="8" Command="{Binding SaveQuickStockCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>