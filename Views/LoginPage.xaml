<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ControlInventario.Shared.Models;assembly=ControlInventario.Shared"
             xmlns:helpers="clr-namespace:ControlInventarioMovil.Helpers"
             x:Class="ControlInventarioMovil.Views.LoginPage"
             NavigationPage.HasNavigationBar="False" 
             Shell.NavBarIsVisible="False"
             SizeChanged="OnPageSizeChanged">

    <!-- 🚀 AQUÍ ES EL LUGAR CORRECTO PARA LOS RECURSOS (Adentro del ContentPage) -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:Base64ToImageConverter x:Key="Base64Converter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Fondo Animado -->
        <Grid BackgroundColor="#1E003B" InputTransparent="True">
            <Ellipse x:Name="orbMorado" WidthRequest="300" HeightRequest="300" HorizontalOptions="Start" VerticalOptions="Start" Margin="-50,-50,0,0" Opacity="0.7">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8A2BE2" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="orbAzul" WidthRequest="350" HeightRequest="350" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-50,-50" Opacity="0.7">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0000FF" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="orbCeleste" WidthRequest="250" HeightRequest="250" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.7">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00CED1" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Contenedor Maestro Responsivo -->
        <Grid x:Name="LayoutGrid" RowDefinitions="Auto, *" ColumnDefinitions="*">

            <!-- BLOQUE 1: Bienvenida y Logos -->
            <VerticalStackLayout x:Name="HeaderSection" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" Spacing="10" Padding="30,30,30,10">
                <Image Source="dotnet_bot.png" HeightRequest="70" HorizontalOptions="Center" Margin="0,0,0,10" />
                <Label Text="¡Bienvenido!" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                <Label Text="Selecciona tu sucursal:" FontSize="16" TextColor="#E0E0E0" HorizontalOptions="Center" />

                <CollectionView x:Name="cvCompanies" SelectionMode="Single" SelectionChanged="OnCompanySelected" HeightRequest="90" HorizontalOptions="Center" Margin="0,10">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="Transparent" StrokeThickness="3" BackgroundColor="#40000000" WidthRequest="70" HeightRequest="70" StrokeShape="RoundRectangle 35" Padding="5">
                                <!-- 🚀 EL CONVERTER APLICADO A LA IMAGEN -->
                                <Image Source="{Binding LogoUrl, Converter={StaticResource Base64Converter}}" Aspect="AspectFit" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="Stroke" Value="{Binding PrimaryColorHex}" />
                                                <Setter Property="BackgroundColor" Value="#80FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- BLOQUE 2: Formulario de Login -->
            <ScrollView x:Name="FormSection" Grid.Row="1" Grid.Column="0" VerticalOptions="Center">
                <VerticalStackLayout Padding="30,10,30,30" Spacing="10">
                    <Border Stroke="#60FFFFFF" StrokeThickness="1" BackgroundColor="#40000000" Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Usuario:" TextColor="#A0E2FF" FontSize="14" />
                            <Border x:Name="borderUser" Stroke="#A0E2FF" StrokeThickness="1" BackgroundColor="#30000000" Padding="10,0" HeightRequest="45">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Entry x:Name="txtUsername" TextColor="White" Placeholder="Tu usuario" PlaceholderColor="#80FFFFFF" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>

                            <Label Text="Contraseña:" TextColor="#A0E2FF" FontSize="14" Margin="0,5,0,0" />
                            <Border x:Name="borderPass" Stroke="#A0E2FF" StrokeThickness="1" BackgroundColor="#30000000" Padding="10,0" HeightRequest="45">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Entry x:Name="txtPassword" Grid.Column="0" IsPassword="True" TextColor="White" Placeholder="••••••••" PlaceholderColor="#80FFFFFF" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                    <ImageButton x:Name="imgShowPassword" Source="eye_closed.png" Grid.Column="1" HeightRequest="25" WidthRequest="25" BackgroundColor="Transparent" VerticalOptions="Center" Clicked="OnShowPasswordTapped" helpers:EfectosVisualesHelper.Animar="True"/>
                                </Grid>
                            </Border>

                            <HorizontalStackLayout VerticalOptions="Center" Margin="0,15,0,0">
                                <CheckBox x:Name="chkRememberMe" Color="#00CED1"/>
                                <Label Text="Recordarme" TextColor="White" VerticalOptions="Center" FontSize="14" />
                            </HorizontalStackLayout>

                            <Label Text="¿Olvidaste tu contraseña?" TextColor="#E0E0E0" TextDecorations="Underline" HorizontalOptions="Center" Margin="0,0,0,10" FontSize="14">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnForgot_Tapped" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Button x:Name="btnLogin" Text="Ingresar" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="45" Clicked="OnLoginClicked" helpers:EfectosVisualesHelper.Animar="True">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4B0082" Offset="0.0" />
                                        <GradientStop Color="#0000FF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="lblStatus" Text="" TextColor="LightGreen" HorizontalOptions="Center"/>
                    <Label Text="© 2026. Todos los derechos reservados." TextColor="#A0A0A0" FontSize="12" HorizontalOptions="Center" />
                    <ActivityIndicator x:Name="loading" IsRunning="False" IsVisible="{Binding Source={x:Reference loading}, Path=IsRunning}" Color="#512BD4" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>