<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlInventarioMovil.Views.CompanyFormPage"
             xmlns:helpers="clr-namespace:ControlInventarioMovil.Helpers"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#161F27}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:Base64ToImageConverter x:Key="Base64Converter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" VerticalOptions="Fill">
        <Grid Grid.Row="0" ColumnDefinitions="50, *, 50" Padding="15,10" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A232C}">
            <ImageButton Grid.Column="0" Source="arrow_back.png" Aspect="AspectFit" BackgroundColor="Transparent" Padding="10" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnVolverClicked"/>
            <Label x:Name="lblTituloPantalla" Grid.Column="1" Text="NUEVA SUCURSAL" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
            <BoxView Grid.Column="2" Color="Transparent" />
        </Grid>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="20">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Border WidthRequest="120" HeightRequest="120" StrokeShape="RoundRectangle 60" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}">
                        <!-- Usamos el converter aquí también para previsualizar si estamos editando -->
                        <Image x:Name="imgLogoPreview" Source="add_icon.png" Aspect="AspectFill" Margin="0" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSeleccionarLogoTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Label Text="Toca para subir logo" FontSize="12" TextColor="{AppThemeBinding Light=#54606C, Dark=#8A9AAB}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Nombre de la Empresa" FontSize="14" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" />
                    <Border Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" StrokeShape="RoundRectangle 8" Padding="10,0" HeightRequest="50">
                        <Entry x:Name="txtBusinessName" Placeholder="Ej. AgroSur S.A.C." TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" PlaceholderColor="#8A9AAB" BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="RUC" FontSize="14" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" />
                    <Border Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" StrokeShape="RoundRectangle 8" Padding="10,0" HeightRequest="50">
                        <Entry x:Name="txtRuc" Placeholder="11 dígitos" Keyboard="Numeric" MaxLength="11" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" PlaceholderColor="#8A9AAB" BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Color de Marca" FontSize="14" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" />
                    <FlexLayout x:Name="ColorPaletteLayout" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center" />
                </VerticalStackLayout>

                <HorizontalStackLayout x:Name="panelEstado" Spacing="10" IsVisible="False" VerticalOptions="Center" Margin="0,10,0,0">
                    <Switch x:Name="switchEstado" OnColor="#2E7D32" />
                    <Label Text="Sucursal Activa (Operativa)" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button x:Name="btnGuardar" Text="Guardar Empresa" FontAttributes="Bold" TextColor="White" HeightRequest="50" CornerRadius="10" Margin="0,20,0,0" Clicked="OnGuardarClicked" helpers:EfectosVisualesHelper.Animar="True">
                    <Button.Background>
                        <SolidColorBrush x:Name="btnGuardarBackground" Color="#2E7D32" />
                    </Button.Background>
                </Button>

                <ActivityIndicator x:Name="loading" IsRunning="False" IsVisible="False" Color="#2E7D32" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>