<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlInventarioMovil.Views.CategoriasPage"
             xmlns:helpers="clr-namespace:ControlInventarioMovil.Helpers"
             xmlns:models="clr-namespace:ControlInventario.Shared.Models;assembly=ControlInventario.Shared"
             Title="Categorías"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}">

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,20,15,15" BackgroundColor="{AppThemeBinding Light=#1B4F5F, Dark=#161F27}">
                <Label Grid.Column="0" Grid.ColumnSpan="3" Text="CATEGORÍAS" TextColor="White" FontAttributes="Bold" FontSize="16" CharacterSpacing="1" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                <ImageButton Grid.Column="0" Source="arrow_back.png" WidthRequest="28" HeightRequest="28" BackgroundColor="Transparent" Padding="0" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnVolverClicked"/>
            </Grid>

            <Grid Grid.Row="1" Padding="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Text="CATEGORÍAS REGISTRADAS" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>

                <CollectionView x:Name="ColCategoriasPadre" Grid.Row="1">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Null}">
                            <VerticalStackLayout Margin="0,0,0,15">

                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="15" Margin="0,15,0,0" ZIndex="1">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontSize="16" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description, TargetNullValue='Sin descripción'}" TextColor="{AppThemeBinding Light=#54606C, Dark=#606A72}" FontSize="12" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8" VerticalOptions="Start">
                                            <ImageButton Source="edit_icon.png" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#2E3842}" CornerRadius="6" WidthRequest="32" HeightRequest="32" Padding="8" helpers:EfectosVisualesHelper.Animar="True" CommandParameter="{Binding .}" Clicked="OnEditarPadreClicked"/>
                                            <ImageButton Source="delete_icon.png" BackgroundColor="{AppThemeBinding Light=#FCE8E6, Dark=#3D2321}" CornerRadius="6" WidthRequest="32" HeightRequest="32" Padding="8" helpers:EfectosVisualesHelper.Animar="True" CommandParameter="{Binding .}" Clicked="OnEliminarPadreClicked"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="5" HorizontalOptions="Start" helpers:EfectosVisualesHelper.Animar="True" IsVisible="{Binding TieneHijas}">
                                            <HorizontalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnToggleSubcategoriasTapped" CommandParameter="{Binding .}"/>
                                            </HorizontalStackLayout.GestureRecognizers>
                                            <Label Text="{Binding ToggleText}" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                    </Grid>
                                </Border>

                                <Grid x:Name="ContenedorHijas" IsVisible="False" Opacity="0" Margin="25,8,0,0">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Subcategorias}" Spacing="8" Margin="0,10,0,0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="{x:Null}">
                                                <Grid ColumnDefinitions="20, *">
                                                    <Grid Grid.Column="0">
                                                        <BoxView WidthRequest="2" BackgroundColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" HorizontalOptions="Start" VerticalOptions="Fill" Margin="10,-10,0,0" TranslationY="-35"/>
                                                        <BoxView HeightRequest="2" BackgroundColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" HorizontalOptions="Fill" VerticalOptions="Center" Margin="10,0,0,0"/>
                                                    </Grid>
                                                    <Border Grid.Column="1" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E9ECEF, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1A2229}" Padding="12,10">
                                                        <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                                <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontSize="14" FontAttributes="Bold"/>
                                                                <Label Text="{Binding Description, TargetNullValue='Sin descripción'}" TextColor="{AppThemeBinding Light=#54606C, Dark=#606A72}" FontSize="11" LineBreakMode="TailTruncation"/>
                                                            </VerticalStackLayout>
                                                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#232B35}" StrokeShape="RoundRectangle 4" StrokeThickness="0" Padding="10,3" VerticalOptions="Center">
                                                                <Label Text="{Binding TrackingMode}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="9" FontAttributes="Bold"/>
                                                            </Border>
                                                            <ImageButton Grid.Column="2" Source="config_icon.png" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" ToolTipProperties.Text="Configurar Unidades" CommandParameter="{Binding .}" Clicked="OnConfigurarUnidadesClicked" VerticalOptions="Center">
                                                                <ImageButton.Triggers>
                                                                    <DataTrigger TargetType="ImageButton" Binding="{Binding TrackingMode}" Value="Serialized">
                                                                        <Setter Property="IsVisible" Value="False" />
                                                                    </DataTrigger>

                                                                    <DataTrigger TargetType="ImageButton" Binding="{Binding TrackingMode}" Value="Serializado">
                                                                        <Setter Property="IsVisible" Value="False" />
                                                                    </DataTrigger>
                                                                </ImageButton.Triggers>
                                                            </ImageButton>
                                                            <ImageButton Grid.Column="3" Source="edit_icon.png" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" CommandParameter="{Binding .}" Clicked="OnEditarHijaClicked" VerticalOptions="Center"/>
                                                            <ImageButton Grid.Column="4" Source="delete_icon.png" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" CommandParameter="{Binding .}" Clicked="OnEliminarSubcategoriaClicked" VerticalOptions="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15" Margin="0,60,0,0">
                            <Image Source="box_empty.png" HeightRequest="80" WidthRequest="80" Opacity="0.4" HorizontalOptions="Center"/>
                            <Label Text="Aún no hay categorías" TextColor="{AppThemeBinding Light=#1B4F5F, Dark=#A2D149}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Toca el botón 'AGREGAR CATEGORÍA P.' en la parte inferior para crear tu primer grupo comercial." TextColor="{AppThemeBinding Light=#54606C, Dark=#606A72}" FontSize="13" HorizontalTextAlignment="Center" Margin="20,0"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="12" Padding="15,10,15,15" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#161F27}">
                <Button Grid.Column="0" Text="AGREGAR CATEGORÍA H." BackgroundColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnAgregarHijaClicked"/>
                <Button Grid.Column="1" Text="AGREGAR CATEGORÍA P." BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" TextColor="{AppThemeBinding Light=White, Dark=#1C262E}" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnAgregarPadreClicked"/>
            </Grid>
        </Grid>

        <Grid x:Name="FormOverlay" RowDefinitions="Auto, *, Auto" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}" IsVisible="False" TranslationY="1000" ZIndex="5">
            <Grid Grid.Row="0" Padding="15,20,15,15" BackgroundColor="{AppThemeBinding Light=#1B4F5F, Dark=#161F27}">
                <Label x:Name="LblFormTitulo" Text="AGREGAR CATEGORÍA" TextColor="White" FontAttributes="Bold" FontSize="16" CharacterSpacing="1" HorizontalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1" Padding="15,10,15,15">
                <VerticalStackLayout Spacing="20">
                    <Label Text="IDENTIDAD DE CATEGORÍA" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto" ColumnSpacing="12" Margin="0,-10,0,0">

                        <VerticalStackLayout x:Name="SecNombre" Grid.Column="0" Spacing="5">
                            <Label Text="Nombre (Oblig.)" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="12"/>
                            <Border HeightRequest="40" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="10,0">
                                <Entry x:Name="TxtNombreCat" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" Placeholder="Ej. Laptops" PlaceholderColor="{AppThemeBinding Light=#8895A5, Dark=#606A72}" VerticalOptions="Fill" VerticalTextAlignment="Center" BackgroundColor="Transparent" Margin="0"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="SecContexto" Grid.Column="1" Spacing="5">
                            <Label Text="Grupo (Padre)" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="12"/>
                            <Border HeightRequest="40" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="10,0">
                                <Picker x:Name="PkrPadre" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill" VerticalTextAlignment="Center" Margin="0"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout x:Name="SecReglas">
                        <Label Text="REGLAS Y SEGUIMIENTO" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12" RowDefinitions="Auto, Auto" RowSpacing="15" Margin="0,5,0,0">

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                <Grid ColumnDefinitions="*, Auto" HeightRequest="24">
                                    <Label Grid.Column="0" Text="TrackingMode" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="12" VerticalOptions="Center"/>
                                    <HorizontalStackLayout Grid.Column="1" x:Name="ContenedorRetornable" Spacing="2" VerticalOptions="Center" IsVisible="False">
                                        <Label Text="Retorno" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="10" VerticalOptions="Center"/>
                                        <Switch x:Name="SwRetornable" IsToggled="True" OnColor="#A2D149" ThumbColor="White" Scale="0.6" VerticalOptions="Center" Margin="0,-10,0,-10"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                <Border HeightRequest="40" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="10,0">
                                    <Picker x:Name="PkrTrackingMode" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill" VerticalTextAlignment="Center" SelectedIndexChanged="OnTrackingModeChanged" Margin="0">
                                        <Picker.Items>
                                            <x:String>-- SELECCIONE --</x:String>
                                            <x:String>Serializado</x:String>
                                            <x:String>Estándar</x:String>
                                            <x:String>A Granel</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="SecUnidadesMedida" Grid.Row="0" Grid.Column="1" Spacing="5" IsVisible="False">
                                <Label Text=" " HeightRequest="24" VerticalOptions="Center"/>
                                <Button x:Name="BtnConfigurarUnidades" 
                                        Text="📏 GESTIONAR UNIDADES" 
                                        IsEnabled="False" 
                                        BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#232B35}" 
                                        TextColor="{AppThemeBinding Light=#1B4F5F, Dark=#A2D149}" 
                                        FontAttributes="Bold" 
                                        CornerRadius="8" 
                                        HeightRequest="40" 
                                        MinimumHeightRequest="0"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalOptions="Fill" 
                                        BorderColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" 
                                        BorderWidth="1" 
                                        helpers:EfectosVisualesHelper.Animar="True" 
                                        Clicked="OnConfigurarUnidadesClicked"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                                <Grid ColumnDefinitions="*, Auto" HeightRequest="24" VerticalOptions="Center">
                                    <Label Text="NamingMethod" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="12" VerticalOptions="Center"/>

                                    <HorizontalStackLayout x:Name="ContenedorCheckLibre" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Libre" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="10" VerticalOptions="Center"/>
                                        <Switch x:Name="SwModoLibre" IsToggled="False" OnColor="#A2D149" ThumbColor="White" Scale="0.6" VerticalOptions="Center" Margin="0,-10,0,-10" Toggled="OnModoLibreToggled"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <Border x:Name="ContainerPickerNaming" HeightRequest="40" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="10,0" VerticalOptions="Center">
                                    <Picker x:Name="PkrNaming" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Center" Margin="0" />
                                </Border>

                                <Border x:Name="ContainerTxtNaming" IsVisible="False" HeightRequest="40" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="10,0" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Grid.Column="0" Text="Fórmula:" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8895A5, Dark=#606A72}" FontSize="12" FontAttributes="Bold" Margin="0,0,8,0"/>
                                        <Entry Grid.Column="1" x:Name="TxtNamingCustom" Text="[Marca]" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontAttributes="Bold" FontSize="12" IsReadOnly="True" VerticalOptions="Center" BackgroundColor="Transparent"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="ContainerBotonesNaming" Grid.Row="1" Grid.Column="1" Spacing="5" IsVisible="False" VerticalOptions="End">
                                <Label Text="Toca para agregar a la estructura:" TextColor="{AppThemeBinding Light=#8895A5, Dark=#606A72}" FontSize="11" FontAttributes="Italic" HeightRequest="24" VerticalOptions="Center" Margin="0,0,0,0"/>
                                <Grid x:Name="GridBotonesNaming" ColumnDefinitions="*, *, *, *, *" ColumnSpacing="6" HeightRequest="40">
                                    <Button x:Name="BtnTagMarca" Grid.Column="0" Text="Marca" HeightRequest="40" MinimumHeightRequest="0" Margin="0" Padding="0" CornerRadius="8" FontSize="10" FontAttributes="Bold" Clicked="OnNamingTagClicked" BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" TextColor="{AppThemeBinding Light=White, Dark=#1C262E}"/>
                                    <Button x:Name="BtnTagCodigo" Grid.Column="1" Text="Código" HeightRequest="40" MinimumHeightRequest="0" Margin="0" Padding="0" CornerRadius="8" FontSize="10" FontAttributes="Bold" Clicked="OnNamingTagClicked" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#232B35}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}"/>
                                    <Button x:Name="BtnTagSerie" Grid.Column="2" Text="Serie" HeightRequest="40" MinimumHeightRequest="0" Margin="0" Padding="0" CornerRadius="8" FontSize="10" FontAttributes="Bold" Clicked="OnNamingTagClicked" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#232B35}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}"/>
                                    <Button x:Name="BtnTagModelo" Grid.Column="3" Text="Modelo" HeightRequest="40" MinimumHeightRequest="0" Margin="0" Padding="0" CornerRadius="8" FontSize="10" FontAttributes="Bold" Clicked="OnNamingTagClicked" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#232B35}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}"/>
                                    <Button x:Name="BtnTagPresentacion" Grid.Column="4" Text="Pres." ToolTipProperties.Text="Presentación" HeightRequest="40" MinimumHeightRequest="0" Margin="0" Padding="0" CornerRadius="8" FontSize="10" FontAttributes="Bold" Clicked="OnNamingTagClicked" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#232B35}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}"/>
                                </Grid>
                            </VerticalStackLayout>

                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="NOTAS ADICIONALES" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>
                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="10">
                            <Editor x:Name="TxtDescription" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" Placeholder="Detalles sobre el uso..." PlaceholderColor="{AppThemeBinding Light=#8895A5, Dark=#606A72}" HeightRequest="70"/>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="12" Padding="15,10,15,15" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#161F27}">
                <Button Grid.Column="0" Text="CANCELAR" BackgroundColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" TextColor="{AppThemeBinding Light=#1C262E, Dark=#939CA5}" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" Clicked="OnCerrarFormClicked"/>
                <Button Grid.Column="1" Text="CONFIRMAR" BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" TextColor="{AppThemeBinding Light=White, Dark=#1C262E}" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" Clicked="OnConfirmarFormClicked"/>
            </Grid>
        </Grid>

        <Grid x:Name="OverlayUnidades" RowDefinitions="Auto, *, Auto" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}" IsVisible="False" TranslationY="1000" ZIndex="10">
            <Grid Grid.Row="0" Padding="15,20,15,15" BackgroundColor="{AppThemeBinding Light=#1B4F5F, Dark=#161F27}">
                <Label Text="UNIDADES PERMITIDAS" TextColor="White" FontAttributes="Bold" FontSize="16" CharacterSpacing="1" HorizontalOptions="Center"/>
            </Grid>
            <CollectionView x:Name="CvUnidades" Grid.Row="1" Margin="15">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Null}">
                        <Grid Padding="0,0,0,12">

                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="20,10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="6">
                                        <Label Text="{Binding Unit.Abbreviation}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center"/>
                                        <Label Text="{Binding Unit.UnitName, StringFormat='({0})'}" TextColor="{AppThemeBinding Light=#8895A5, Dark=#606A72}" FontSize="13" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Switch Grid.Column="1" IsToggled="{Binding IsSelected}" OnColor="#A2D149" ThumbColor="White" VerticalOptions="Center" Toggled="OnUnitSwitchToggled"/>
                                </Grid>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Cargando unidades maestras..." TextColor="Gray" HorizontalOptions="Center" Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
            <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="12" Padding="15,10,15,15" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#161F27}">
                <Button Grid.Column="0" Text="VOLVER" BackgroundColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" TextColor="{AppThemeBinding Light=#1C262E, Dark=#939CA5}" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" Clicked="OnCerrarUnidadesClicked"/>
                <Button Grid.Column="1" Text="GUARDAR UNIDADES" BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" TextColor="{AppThemeBinding Light=White, Dark=#1C262E}" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" Clicked="OnConfirmarUnidadesClicked"/>
            </Grid>
        </Grid>
        <Grid x:Name="OverlayCarga" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}" ZIndex="20">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="#A2D149" HeightRequest="50" WidthRequest="50"/>
                <Label Text="Cargando categorías..." TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>