<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ControlInventario.Shared.Models;assembly=ControlInventario.Shared"
             xmlns:localViews="clr-namespace:ControlInventarioMovil.Views"
             xmlns:helpers="clr-namespace:ControlInventarioMovil.Helpers"
             x:Class="ControlInventarioMovil.Views.InventoryPage"
             Title="Inventario Real"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,20,15,15" BackgroundColor="{AppThemeBinding Light=#1B4F5F, Dark=#161F27}">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label x:Name="LblNombreAlmacen" Text="ALMACÉN ACTIVO" TextColor="{AppThemeBinding Light=White, Dark=#A2D149}" FontAttributes="Bold" FontSize="15" CharacterSpacing="0.5"/>
                <Label Text="Listado oficial de existencias en tiempo real" TextColor="{AppThemeBinding Light=#CDD5DB, Dark=#606A72}" FontSize="11"/>
            </VerticalStackLayout>
            <ImageButton Grid.Column="1" Source="config_icon.png" WidthRequest="22" HeightRequest="22" BackgroundColor="Transparent" Padding="0" VerticalOptions="Center" Margin="0,0,10,0" Opacity="0.8" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnConfigCategoriesClicked"/>
        </Grid>

        <!-- 🚀 1. DIVIDIMOS ESTE GRID PARA METER LOS 3 BOTONES DE CLASIFICACIÓN -->
        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *" Padding="15,12">

            <!-- Los 3 Botones de Categorías -->
            <Grid Grid.Row="0" ColumnDefinitions="*, *, *" Margin="0,0,0,12" ColumnSpacing="8">
                <Button x:Name="BtnStandard" Grid.Column="0" Text="📦 Estándar" FontSize="11" FontAttributes="Bold" CornerRadius="6" BackgroundColor="#8A2BE2" TextColor="White" Clicked="OnTabStandardClicked" Padding="0"/>
                <Button x:Name="BtnBulk" Grid.Column="1" Text="⚖️ Bulk" FontSize="11" FontAttributes="Bold" CornerRadius="6" BackgroundColor="Transparent" TextColor="Gray" BorderColor="Gray" BorderWidth="1" Clicked="OnTabBulkClicked" Padding="0"/>
                <Button x:Name="BtnSerialized" Grid.Column="2" Text="📱 Serial" FontSize="11" FontAttributes="Bold" CornerRadius="6" BackgroundColor="Transparent" TextColor="Gray" BorderColor="Gray" BorderWidth="1" Clicked="OnTabSerializedClicked" Padding="0"/>
            </Grid>

            <Button Grid.Row="1" x:Name="BtnToggleStock" Text="Ver Agotados (Stock 0)" Clicked="OnToggleStockCeroClicked" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#2E3842}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" CornerRadius="6" HeightRequest="36" FontSize="11" HorizontalOptions="End" Margin="0,0,0,10" helpers:EfectosVisualesHelper.Animar="True"/>

            <Grid Grid.Row="2">
                <VerticalStackLayout x:Name="SecEstadoVacio" IsVisible="False" VerticalOptions="Center" Spacing="10">
                    <Image Source="reportes.png" HeightRequest="50" WidthRequest="50" Opacity="0.3" HorizontalOptions="Center"/>
                    <Label Text="Almacén sin existencias" TextColor="{AppThemeBinding Light=#1C262E, Dark=#939CA5}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="Presiona el botón inferior para registrar el primer artículo en este ambiente o cambia el filtro de stock." TextColor="{AppThemeBinding Light=#54606C, Dark=#606A72}" FontSize="12" HorizontalTextAlignment="Center" Padding="30,0"/>
                </VerticalStackLayout>

                <Grid x:Name="ContenedorLista">
                    <CollectionView x:Name="CvwArticulos" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="localViews:ArticleUI">
                                <!-- 🚀 2. METIMOS TU TARJETA EN UN VERTICAL STACK PARA EL ACORDEÓN -->
                                <VerticalStackLayout Spacing="0" Padding="0,0,0,10">
                                    <Border StrokeShape="RoundRectangle 8" 
                                            Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#26313C}" 
                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#222B34}" 
                                            Padding="15,14">

                                        <!-- Habilitamos el toque en toda la tarjeta para abrir el acordeón -->
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnProductHeaderTapped" />
                                        </Border.GestureRecognizers>

                                        <!-- Agregamos una 4ta columna para la flecha -->
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, Auto" RowSpacing="0" ColumnSpacing="12">

                                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" WidthRequest="75" HeightRequest="85" StrokeShape="RoundRectangle 8" StrokeThickness="0" IsVisible="{Binding ShowThumbnail}" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1A232D}" VerticalOptions="Fill">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnFotoRapidaTapped" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2" Opacity="0.5">
                                                        <Label Text="📷" FontSize="20" HorizontalOptions="Center"/>
                                                        <Label Text="Sin foto" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}"/>
                                                    </VerticalStackLayout>
                                                    <Image Source="{Binding MainPhotoPath}" Aspect="AspectFill" />
                                                </Grid>
                                            </Border>

                                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" FontSize="20" LineBreakMode="TailTruncation" VerticalOptions="Center"/>

                                                <HorizontalStackLayout Spacing="6">
                                                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1A232D}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8,3" VerticalOptions="Center">
                                                        <HorizontalStackLayout Spacing="4">
                                                            <Label Text="🆔" FontSize="10" VerticalOptions="Center"/>
                                                            <Label Text="{Binding Code}" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                    </Border>

                                                    <Border BackgroundColor="{AppThemeBinding Light=#E1F5FE, Dark=#112533}" Stroke="{AppThemeBinding Light=#B3E5FC, Dark=#1E4663}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8,3" VerticalOptions="Center">
                                                        <HorizontalStackLayout Spacing="4">
                                                            <Label Text="📦" FontSize="10" VerticalOptions="Center"/>
                                                            <Label Text="{Binding MeasurementUnitShort}" TextColor="{AppThemeBinding Light=#0288D1, Dark=#29B6F6}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Row="0" Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" Spacing="3">
                                                <HorizontalStackLayout Spacing="5" HorizontalOptions="End">
                                                    <Label Text="Costo Adq:" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding AcquisitionDisplay}" TextColor="{AppThemeBinding Light=#E65100, Dark=#EFA72F}" FontAttributes="Bold" FontSize="12" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="5" HorizontalOptions="End" IsVisible="{Binding IsConversionVisible}">
                                                    <Label Text="P. Origen:" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding OriginalSaleDisplay}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" Opacity="0.9"/>
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="5" HorizontalOptions="End">
                                                    <Label Text="P. Venta:" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding ConvertedSaleDisplay}" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <Label Grid.Row="0" Grid.Column="3" Text="{Binding ExpansionIcon}" FontSize="18" VerticalOptions="Center" TextColor="Gray" IsVisible="{Binding IsSerialized}" Margin="5,0,0,0"/>

                                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" ColumnDefinitions="Auto, *, Auto" Margin="0,10,0,0">

                                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                    <Border HeightRequest="38" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B3B2B}" Stroke="{AppThemeBinding Light=#C8E6C9, Dark=#2E7D32}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="2,0">
                                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                            <ImageButton Source="minus_icon.png" WidthRequest="30" HeightRequest="30" MinimumHeightRequest="30" MinimumWidthRequest="30" Padding="5" Aspect="AspectFit" BackgroundColor="Transparent" VerticalOptions="Center" Clicked="OnDisminuirStockPendienteClicked" CommandParameter="{Binding .}"/>

                                                            <Entry Text="{Binding DisplayStock, Mode=TwoWay, StringFormat='{0:0.##}'}" TextChanged="OnStockTextChanged" Keyboard="Numeric" TextColor="{Binding ActionColor}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" VerticalTextAlignment="Center" HorizontalOptions="Center" WidthRequest="40" HeightRequest="38" Margin="0" HorizontalTextAlignment="Center" BackgroundColor="Transparent"/>

                                                            <ImageButton Source="add_icon.png" WidthRequest="30" HeightRequest="30" MinimumHeightRequest="30" MinimumWidthRequest="30" Padding="5" Aspect="AspectFit" BackgroundColor="Transparent" VerticalOptions="Center" Clicked="OnAumentarStockPendienteClicked" CommandParameter="{Binding .}"/>
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                    <ImageButton Source="{Binding ActionIcon}" WidthRequest="32" HeightRequest="32" CornerRadius="6" BackgroundColor="{Binding ActionColor}" VerticalOptions="Center" Padding="7" Opacity="0.9" CommandParameter="{Binding .}" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnBotonInteligenteClicked"/>
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">
                                                    <ImageButton Source="edit_icon.png" WidthRequest="32" HeightRequest="32" CornerRadius="6" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#2E3842}" VerticalOptions="Center" Padding="7" Opacity="0.9" CommandParameter="{Binding .}" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnEditarArticuloClicked"/>
                                                    <ImageButton Source="delete_icon.png" WidthRequest="32" HeightRequest="32" CornerRadius="6" BackgroundColor="{AppThemeBinding Light=#FCE8E6, Dark=#3D2321}" VerticalOptions="Center" Padding="7" Opacity="0.9" CommandParameter="{Binding .}" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnEliminarStockClicked"/>
                                                </HorizontalStackLayout>
                                            </Grid>

                                        </Grid>
                                    </Border>

                                    <!-- 🚀 3. EL CONTENIDO DEL ACORDEÓN (LOS IMEIs) -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Serials}" 
                                                         IsVisible="{Binding IsExpanded}"
                                                         Margin="25,8,25,5" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="localViews:ArticleSerialDto">
                                                <Border Padding="12,10" BackgroundColor="{AppThemeBinding Light=#EBE6F7, Dark=#201633}" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Grid ColumnDefinitions="25, *, Auto, Auto" ColumnSpacing="12">
                                                        <Label Grid.Column="0" Text="🟢" FontSize="10" VerticalOptions="Center"/>

                                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="0,0,5,0">
                                                            <Label Text="{Binding SerialNumber}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light=#8A2BE2, Dark=#B67BFF}" LineBreakMode="TailTruncation"/>

                                                            <Label Text="{Binding UniqueAttributesDisplay}" FontSize="10" TextColor="{AppThemeBinding Light=#E65100, Dark=#EFA72F}" FontAttributes="Italic" IsVisible="{Binding HasUniqueAttributes}" LineBreakMode="TailTruncation"/>

                                                            <Label Text="{Binding Location, StringFormat='Ubicación: {0}'}" FontSize="11" TextColor="Gray" LineBreakMode="TailTruncation"/>
                                                        </VerticalStackLayout>

                                                        <Label Grid.Column="2" Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="#00CED1" VerticalOptions="Center" LineBreakMode="TailTruncation" Margin="0,0,5,0"/>

                                                        <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                                                            <ImageButton Source="edit_icon.png" WidthRequest="26" HeightRequest="26" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#2E3842}" CornerRadius="4" Padding="5" Clicked="OnEditarSerieClicked" CommandParameter="{Binding .}"/>
                                                            <ImageButton Source="delete_icon.png" WidthRequest="26" HeightRequest="26" BackgroundColor="{AppThemeBinding Light=#FCE8E6, Dark=#3D2321}" CornerRadius="4" Padding="5" Clicked="OnEliminarSerieClicked" CommandParameter="{Binding .}"/>
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="12" Padding="15,12,15,15" BackgroundColor="{AppThemeBinding Light=#1B4F5F, Dark=#161F27}">
            <Button Grid.Column="0" Text="PANEL PRINCIPAL" BackgroundColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" TextColor="{AppThemeBinding Light=#1C262E, Dark=#939CA5}" FontAttributes="Bold" CornerRadius="6" HeightRequest="42" FontSize="12" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnVolverClicked"/>
            <Button x:Name="BtnNuevoArticulo" Grid.Column="1" Text="+ NUEVO ARTÍCULO" BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" TextColor="{AppThemeBinding Light=White, Dark=#1C262E}" FontAttributes="Bold" CornerRadius="6" HeightRequest="42" FontSize="12" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnAgregarArticuloClicked"/>
        </Grid>

        <!-- (El Visor de Fotos se mantiene intacto al final) -->
        <Grid x:Name="OverlayVisorFoto" Grid.RowSpan="3" IsVisible="False" BackgroundColor="#CC000000" Opacity="0" Padding="20">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCerrarVisorClicked" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C262E}" VerticalOptions="Center" HorizontalOptions="Fill" Padding="0" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto, *, Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,15,15,10">
                        <Label x:Name="LblVisorTitulo" Text="Vista Previa" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" VerticalOptions="Center"/>
                        <ImageButton Grid.Column="1" Source="cancel_icon.png" WidthRequest="30" HeightRequest="30" Padding="4" CornerRadius="6" VerticalOptions="Center" HorizontalOptions="End" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnCerrarVisorClicked"/>
                    </Grid>
                    <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#161F27}" StrokeThickness="0" HeightRequest="350">
                        <Grid>
                            <Image x:Name="ImgVisorAmpliado" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="10" Padding="15">
                        <Button Grid.Column="0" Text="ELIMINAR" BackgroundColor="#FCE8E6" TextColor="#D32F2F" FontAttributes="Bold" CornerRadius="6" HeightRequest="42" Clicked="OnEliminarFotoVisorClicked"/>
                        <Button Grid.Column="1" Text="CAMBIAR FOTO" BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" TextColor="{AppThemeBinding Light=White, Dark=#1C262E}" FontAttributes="Bold" CornerRadius="6" HeightRequest="42" Clicked="OnCambiarFotoVisorClicked"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="OverlayAgregarSerie" Grid.RowSpan="3" BackgroundColor="#CC000000" IsVisible="False" Opacity="0" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>
            <Border VerticalOptions="Center" HorizontalOptions="Fill" Margin="20" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- CABECERA -->
                    <VerticalStackLayout Grid.Row="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#1B4F5F, Dark=#161F27}">
                        <Label Text="AGREGAR UNIDADES SERIALIZADAS" TextColor="{AppThemeBinding Light=White, Dark=#A2D149}" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14"/>
                        <Label x:Name="LblOverlayArticuloNombre" Text="Producto" TextColor="{AppThemeBinding Light=#CDD5DB, Dark=White}" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0" FontSize="16" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- CUERPO DINÁMICO (Genera N tarjetas según el stock) -->
                    <ScrollView Grid.Row="1" MaximumHeightRequest="450">
                        <VerticalStackLayout x:Name="ContenedorSeriesDinamicas" Padding="20" Spacing="15">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Padding="15">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="10">
                                            <Label Text="{Binding Titulo}" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" FontAttributes="Bold" FontSize="13"/>

                                            <!-- Número de Serie Base -->
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Número de Serie / IMEI (Obligatorio) *" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11"/>
                                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#161F27}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="40">
                                                    <Entry Text="{Binding SerialNumber}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" Placeholder="Ej: IMEI-99887766" BackgroundColor="Transparent"/>
                                                </Border>
                                            </VerticalStackLayout>

                                            <!-- Atributos Únicos Dinámicos -->
                                            <VerticalStackLayout Spacing="10">
                                                <VerticalStackLayout IsVisible="{Binding ShowAttr1}" Spacing="2">
                                                    <Label Text="{Binding LabelAttr1}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11"/>
                                                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#161F27}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="40">
                                                        <Entry Text="{Binding ValAttr1}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent"/>
                                                    </Border>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout IsVisible="{Binding ShowAttr2}" Spacing="2">
                                                    <Label Text="{Binding LabelAttr2}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11"/>
                                                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#161F27}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="40">
                                                        <Entry Text="{Binding ValAttr2}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent"/>
                                                    </Border>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout IsVisible="{Binding ShowAttr3}" Spacing="2">
                                                    <Label Text="{Binding LabelAttr3}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11"/>
                                                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#161F27}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="40">
                                                        <Entry Text="{Binding ValAttr3}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent"/>
                                                    </Border>
                                                </VerticalStackLayout>
                                                
                                                <VerticalStackLayout IsVisible="{Binding ShowAttr4}" Spacing="2">
                                                    <Label Text="{Binding LabelAttr4}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11"/>
                                                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#161F27}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="40">
                                                        <Entry Text="{Binding ValAttr4}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent"/>
                                                    </Border>
                                                </VerticalStackLayout>
                                                
                                                <VerticalStackLayout IsVisible="{Binding ShowAttr5}" Spacing="2">
                                                    <Label Text="{Binding LabelAttr5}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11"/>
                                                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#161F27}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="40">
                                                        <Entry Text="{Binding ValAttr5}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent"/>
                                                    </Border>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout IsVisible="{Binding ShowAttr6}" Spacing="2">
                                                    <Label Text="{Binding LabelAttr6}" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11"/>
                                                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#161F27}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="40">
                                                        <Entry Text="{Binding ValAttr6}" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent"/>
                                                    </Border>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- PIE DE BOTONES -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15" Padding="20" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#161F27}">
                        <Button Grid.Column="0" Text="CANCELAR" BackgroundColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" TextColor="{AppThemeBinding Light=#54606C, Dark=White}" FontAttributes="Bold" Clicked="OnCancelarMultiplesSeriesClicked" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="GUARDAR UNIDADES" BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#A2D149}" TextColor="{AppThemeBinding Light=White, Dark=#1C262E}" FontAttributes="Bold" Clicked="OnGuardarMultiplesSeriesClicked" CornerRadius="8"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="OverlayEliminarStock" Grid.RowSpan="3" BackgroundColor="#CC000000" IsVisible="False" Opacity="0" ZIndex="105">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="340" BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, *, Auto">
                    <VerticalStackLayout Grid.Row="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#FCE8E6, Dark=#3D2321}">
                        <Label Text="RETIRO DE EXISTENCIAS" TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14"/>
                        <Label x:Name="LblOverlayEliminarNombre" Text="Producto" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0" FontSize="16" HorizontalTextAlignment="Center"/>
                        <Label x:Name="LblOverlayStockActual" Text="Stock Actual: 0" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" HorizontalOptions="Center" FontSize="12"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="15">
                        <Label Text="Tipo de retiro:" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="12"/>
                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" HeightRequest="40">
                            <Picker x:Name="PkrTipoRetiro" SelectedIndexChanged="OnTipoRetiroChanged" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent">
                                <Picker.Items>
                                    <x:String>Retirar una cantidad específica</x:String>
                                    <x:String>Vaciar todo el stock a 0 (Dar de baja)</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <VerticalStackLayout x:Name="ContenedorCantidadRetiro" Spacing="2">
                            <Label Text="Cantidad a retirar *" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="40">
                                <Entry x:Name="TxtCantidadRetiro" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Motivo / Observación (Obligatorio) *" TextColor="{AppThemeBinding Light=#54606C, Dark=#939CA5}" FontSize="11"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B35}" Stroke="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0" HeightRequest="60">
                                <Editor x:Name="TxtMotivoRetiro" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" BackgroundColor="Transparent" Placeholder="Ej: Producto dañado..."/>
                            </Border>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <ImageButton Source="camera_icon.png" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#2E3842}" WidthRequest="40" HeightRequest="40" CornerRadius="6" Padding="8" Clicked="OnTomarFotoRetiroClicked"/>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Evidencia Fotográfica" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}"/>
                                <Label x:Name="LblFotoRetiroEstado" Text="(Opcional) Sin foto" FontSize="10" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15" Padding="20" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#161F27}">
                        <Button Grid.Column="0" Text="CANCELAR" BackgroundColor="{AppThemeBinding Light=#CDD5DB, Dark=#2E3842}" TextColor="{AppThemeBinding Light=#54606C, Dark=White}" FontAttributes="Bold" Clicked="OnCancelarRetiroClicked" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="CONFIRMAR" BackgroundColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}" TextColor="White" FontAttributes="Bold" Clicked="OnConfirmarRetiroClicked" CornerRadius="8"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="OverlayCargando" Grid.RowSpan="3" BackgroundColor="#B3000000" IsVisible="False" ZIndex="110">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                <ActivityIndicator x:Name="ActCargando" IsRunning="False" IsVisible="True" Color="#A2D149" WidthRequest="50" HeightRequest="50" />
                <Label Text="Procesando datos..." TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>