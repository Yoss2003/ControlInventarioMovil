<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:ControlInventarioMovil.Helpers"
             xmlns:models="clr-namespace:ControlInventario.Shared.Models;assembly=ControlInventario.Shared"
             x:Class="ControlInventarioMovil.Views.SalesPage"
             BackgroundColor="{AppThemeBinding Light=#F4F6F7, Dark=#1C262E}"
             Shell.NavBarIsVisible="False"
             Title="">
    
    <Grid>
        <Grid RowDefinitions="Auto, Auto, *" Margin="0">

            <Grid Grid.Row="0" Padding="15,10" ColumnDefinitions="Auto, *" VerticalOptions="Start">
                <ImageButton Grid.Column="0" Source="arrow_back.png" BackgroundColor="Transparent" WidthRequest="25" HeightRequest="25" VerticalOptions="Center" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnBackClicked"/>
                <Label Grid.Column="1" Text="Punto de Venta" TextColor="{AppThemeBinding Light=#1C262E, Dark=White}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" Margin="15,0,0,0" />
            </Grid>

            <Grid Grid.Row="1" Padding="15,5,15,10" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <SearchBar Grid.Column="0" x:Name="searchArticle" Placeholder="Buscar artículo..." TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="#80A0A0A0" HeightRequest="45" TextChanged="OnSearchTextChanged"/>

                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="15">

                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Switch x:Name="switchHideAgotados" IsToggled="False" Toggled="OnHideAgotadosToggled" OnColor="#8A2BE2" />
                        <Label Text="Ocultar agotados" TextColor="{AppThemeBinding Light=#505050, Dark=#E0E0E0}" VerticalOptions="Center" FontSize="13"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Border WidthRequest="110" HeightRequest="40" BackgroundColor="{AppThemeBinding Light=#E0E4E8, Dark=#222E34}" StrokeThickness="0" Padding="3">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>

                            <Grid>
                                <!-- El fondo morado (Thumb) -->
                                <Border x:Name="thumbFondo" WidthRequest="52" HorizontalOptions="Start" BackgroundColor="#8A2BE2" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="17" />
                                    </Border.StrokeShape>
                                </Border>

                                <!-- Contenedor dividido en 2 partes iguales -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="0">

                                    <!-- Icono Lista: Tamaño fijo y centrado absoluto -->
                                    <ImageButton Grid.Column="0" 
                             Source="icon_list.png" 
                             Aspect="AspectFill" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center"
                             BackgroundColor="Transparent" 
                             Clicked="OnListModeClicked" />

                                    <!-- Icono Cuadrícula: Tamaño fijo y centrado absoluto -->
                                    <ImageButton Grid.Column="1" 
                             Source="icon_grid.png" 
                             Aspect="AspectFill" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center"
                             BackgroundColor="Transparent" 
                             Clicked="OnGridModeClicked" />
                                </Grid>
                            </Grid>
                        </Border>
                    </HorizontalStackLayout>

                </HorizontalStackLayout>
            </Grid>

            <Grid Grid.Row="2">

                <CollectionView x:Name="listArticles" Margin="10,0" IsVisible="True">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Article">
                            <Border Margin="5" Padding="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#263238}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Stock}" Value="0">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#171F24}" VerticalOptions="Center" HorizontalOptions="Start">
                                        <Image Source="{Binding MainPhotoPath}" Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                        <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Text="{Binding Model, StringFormat='Modelo: {0}'}" TextColor="#A0A0A0" FontSize="13" />
                                        <HorizontalStackLayout Spacing="15" Margin="0,3,0,0">
                                            <Label Text="{Binding SalePrice, StringFormat='S/. {0:F2}'}" TextColor="#00CED1" FontAttributes="Bold" FontSize="15"/>
                                            <Label Text="{Binding Stock, StringFormat='Stock: {0}'}" TextColor="{AppThemeBinding Light=Gray, Dark=#E0E0E0}" FontSize="13" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="8" HorizontalOptions="End">
                                        <Button Text="-" WidthRequest="38" HeightRequest="38" Padding="0" CornerRadius="19" FontSize="22" FontAttributes="Bold" BackgroundColor="#E0E0E0" TextColor="Black" Clicked="OnDecreaseQuantityClicked">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Stock}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <Label Text="{Binding QuantityInCart}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" WidthRequest="30" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                                        <Button Text="+" WidthRequest="38"  HeightRequest="38" Padding="0" CornerRadius="19" FontSize="22" FontAttributes="Bold" BackgroundColor="#8A2BE2" TextColor="White" Clicked="OnIncreaseQuantityClicked">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Stock}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <CollectionView x:Name="gridArticles" Margin="10,0" IsVisible="False">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Article">
                            <Border Margin="0" Padding="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#263238}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Stock}" Value="0">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="5">
                                    <Border HeightRequest="100" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E9ECEF, Dark=#171F24}">
                                        <Image Source="{Binding MainPhotoPath}" Aspect="AspectFill" />
                                    </Border>

                                    <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" HeightRequest="40" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding SalePrice, StringFormat='S/. {0:F2}'}" TextColor="#00CED1" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center"/>
                                    <Label Text="{Binding Stock, StringFormat='Stock: {0}'}" TextColor="{AppThemeBinding Light=Gray, Dark=#E0E0E0}" FontSize="12" HorizontalOptions="Center"/>

                                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="End" Spacing="8" Margin="0,10,0,0">
                                        <Button Text="-" WidthRequest="38" HeightRequest="38" Padding="0" CornerRadius="19" FontSize="20" FontAttributes="Bold" BackgroundColor="#E0E0E0" TextColor="Black" Clicked="OnDecreaseQuantityClicked">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Stock}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Label Text="{Binding QuantityInCart}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                        <Button Text="+" WidthRequest="38" HeightRequest="38" Padding="0" CornerRadius="19" FontSize="20" FontAttributes="Bold" BackgroundColor="#8A2BE2" TextColor="White" Clicked="OnIncreaseQuantityClicked">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Stock}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Grid>
        
        <Button x:Name="btnAbrirPanel" 
                Text="🛒 ABRIR PANEL DE COBRO" 
                TextColor="White" FontAttributes="Bold" FontSize="14"
                BackgroundColor="#8A2BE2" CornerRadius="25"
                HeightRequest="50" WidthRequest="260"
                HorizontalOptions="Center" VerticalOptions="End" 
                Margin="0,0,0,25" 
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=10, Opacity=0.3}"
                Clicked="OnAbrirPanelClicked" />

        <Border x:Name="panelCobro" VerticalOptions="End" TranslationY="800" IsVisible="False" Padding="20,12" BackgroundColor="{AppThemeBinding Light=White, Dark=#171F24}" StrokeThickness="1" Stroke="#30808080">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="10">

                <Button Grid.Row="0" Grid.ColumnSpan="2" Text="⏬ Ocultar Panel" HeightRequest="30" Padding="0" FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="Gray" Clicked="OnCerrarPanelClicked" Margin="0,-5,0,0"/>

                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnSpacing="6" VerticalOptions="Center" HorizontalOptions="Start">

                    <Picker Grid.Column="0" x:Name="pickerPaymentType" Title="Método" TitleColor="Gray" TextColor="{AppThemeBinding Light=Black, Dark=White}" HeightRequest="58" WidthRequest="180" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#222E34}">
                        <Picker.Items>
                            <x:String>Efectivo</x:String>
                            <x:String>Tarjeta</x:String>
                            <x:String>Billetera digital</x:String>
                            <x:String>Transferencia</x:String>
                            <x:String>Venta a Cuotas</x:String>
                        </Picker.Items>
                    </Picker>

                    <Picker Grid.Column="1" x:Name="pickerSubWallet" Title="¿Cuál?" TitleColor="Gray" TextColor="{AppThemeBinding Light=Black, Dark=White}" HeightRequest="58" WidthRequest="125" IsVisible="False" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#222E34}">
                        <Picker.Items>
                            <x:String>Yape</x:String>
                            <x:String>Plin</x:String>
                            <x:String>Bim</x:String>
                        </Picker.Items>
                    </Picker>

                    <Picker Grid.Column="1" x:Name="pickerSalesMode" Title="Frecuencia" TitleColor="Gray" TextColor="{AppThemeBinding Light=Black, Dark=White}" HeightRequest="58" WidthRequest="140" IsVisible="False" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#222E34}">
                        <Picker.Items>
                            <x:String>Diario</x:String>
                            <x:String>Semanal</x:String>
                            <x:String>Mensual</x:String>
                        </Picker.Items>
                    </Picker>

                    <Border Grid.Column="2" x:Name="gridNumCuotas" HeightRequest="58" WidthRequest="95" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#222E34}" Padding="8,4" IsVisible="False" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="N° Cuotas" FontSize="10" TextColor="Gray" HorizontalOptions="Start"/>
                            <Entry x:Name="txtNumCuotas" Keyboard="Numeric" Placeholder="0" FontSize="13" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" HeightRequest="32" VerticalOptions="Center" Margin="0,-4,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3" x:Name="gridCuotaInicial" HeightRequest="58" WidthRequest="115" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#222E34}" Padding="8,4" IsVisible="False" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="Adelanto" FontSize="10" TextColor="Gray" HorizontalOptions="Start"/>
                            <Entry x:Name="txtCuotaInicial" Keyboard="Numeric" Placeholder="0.00" FontSize="13" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" HeightRequest="32" VerticalOptions="Center" Margin="0,-4,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                    <Button Grid.Column="4" x:Name="btnSimularCuotas" Text="ⓘ" FontSize="18" FontAttributes="Bold" WidthRequest="48" HeightRequest="58" MinimumWidthRequest="48" MinimumHeightRequest="58" Padding="0" BackgroundColor="#8A2BE2" TextColor="White" CornerRadius="8" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Clicked="OnSimularCuotasClicked"/>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="0" WidthRequest="500" HorizontalOptions="Start" VerticalOptions="Center" ColumnDefinitions="110, 45, *" ColumnSpacing="6">
                    <Border Grid.Column="0" HeightRequest="38" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#222E34}" Padding="8,0" VerticalOptions="Center">
                        <Entry x:Name="txtDocument" Placeholder="DNI / RUC" Keyboard="Numeric" MaxLength="11" FontSize="13" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center" Margin="0"/>
                    </Border>
                    <ImageButton Grid.Column="1" x:Name="btnSearchDoc" Source="search_icon.png" Aspect="AspectFit" BackgroundColor="Transparent" CornerRadius="8" HeightRequest="38" WidthRequest="38" VerticalOptions="Center" Clicked="OnSearchDocumentClicked"/>
                    <Border Grid.Column="2" HeightRequest="38" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#222E34}" Padding="8,0" VerticalOptions="Center">
                        <Entry x:Name="txtCustomerName" Placeholder="Cliente (Opcional)" ClearButtonVisibility="WhileEditing" FontSize="13" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" x:Name="gridEfectivoInfo" ColumnDefinitions="Auto, 85" RowDefinitions="58, 38" RowSpacing="10" ColumnSpacing="5" IsVisible="True" VerticalOptions="Center">
                    <Label Grid.Row="0" Grid.Column="0" Text="Recibido:" TextColor="Gray" FontSize="12" VerticalOptions="Center" HorizontalOptions="End"/>
                    <Border Grid.Row="0" Grid.Column="1" HeightRequest="38" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#222E34}" Padding="8,0" VerticalOptions="Center">
                        <Entry x:Name="txtMontoRecibido" Keyboard="Numeric" Placeholder="0.00" FontSize="14" HorizontalTextAlignment="End" TextChanged="OnMontoRecibidoTextChanged" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0" />
                    </Border>
                    <Label Grid.Row="1" Grid.Column="0" Text="Vuelto:" TextColor="Gray" FontSize="12" VerticalOptions="Center" HorizontalOptions="End"/>
                    <Label Grid.Row="1" Grid.Column="1" x:Name="lblVueltoValor" Text="0.00" TextColor="#4CAF50" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" HorizontalOptions="End"/>
                </Grid>

                <Label Grid.Row="3" Grid.Column="0" x:Name="lblTotalItems" Text="0 artículos seleccionados" TextColor="Gray" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start"/>
                <HorizontalStackLayout Grid.Row="3" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="5">
                    <Label Text="Total:" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontSize="14" VerticalOptions="Center"/>
                    <Label x:Name="lblTotalAmount" Text="S/. 0.00" TextColor="#00CED1" FontAttributes="Bold" FontSize="20" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Button Grid.Row="4" Grid.ColumnSpan="2" x:Name="btnCerrarVenta" Text="CERRAR VENTA" TextColor="White" FontAttributes="Bold" HeightRequest="48" CornerRadius="12" helpers:EfectosVisualesHelper.Animar="True" Clicked="OnCheckoutClicked" Margin="0,5,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#8A2BE2" Offset="0.0" />
                            <GradientStop Color="#0000FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentPage>